#!/bin/sh
set -eu

here="$(dirname "$(readlink -f "$0")")"

if [ -z "${FONTCONFIG_FILE:-}" ]; then
  if [ -r /etc/fonts/fonts.conf ]; then
    export FONTCONFIG_FILE=/etc/fonts/fonts.conf
    if [ -z "${FONTCONFIG_PATH:-}" ] && [ -d /etc/fonts ]; then
      export FONTCONFIG_PATH=/etc/fonts
    fi
  fi
elif [ -z "${FONTCONFIG_PATH:-}" ] && [ -d /etc/fonts ]; then
  export FONTCONFIG_PATH=/etc/fonts
fi

exec "$here/usr/bin/kaede-gallery" "$@"
